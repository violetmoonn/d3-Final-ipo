<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#faf9f6;
  --white:#ffffff;
  --ink:#000000;
  --gray:#6f6f6f;
  --gray-light:#9b9b9b;
  --rule:#e2e2e2;
  --tile:#f0efec;
  --bar:#eceaea;
  --sans:"Helvetica Neue",Helvetica,Arial,sans-serif;
  --display:"Anton","Arial Narrow",Impact,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{
  font-family:var(--sans);
  background:var(--paper);
  color:var(--ink);
  line-height:1.4;
  overflow-x:hidden;
}
body.locked{overflow:hidden}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
a{color:inherit;text-decoration:none}
input{font:inherit;color:inherit}
:focus-visible{outline:2px solid #000;outline-offset:2px}


/* ---------- entry gate ---------- */
.gate{
  position:fixed;inset:0;z-index:100;
  background:#fff;
  display:grid;place-content:center;place-items:center;
  cursor:pointer;padding:24px;
  transition:opacity .6s ease, visibility .6s;
}
.gate.gone{opacity:0;visibility:hidden}
.gate h1{
  font-family:"Arial Black",Impact,Anton,sans-serif;
  font-weight:900;
  font-size:36px;
  letter-spacing:-.035em;
  line-height:1;
  color:#000;
  text-align:center;
  text-transform:uppercase;
  white-space:nowrap;
  user-select:none;
}
@media (min-width:640px){.gate h1{font-size:48px}}
@media (min-width:768px){.gate h1{font-size:60px}}
@media (min-width:1024px){.gate h1{font-size:72px}}
body.gated{overflow:hidden}

/* ---------- product detail ---------- */
.pdp{max-width:1180px;margin:0 auto;padding:20px 16px 80px;width:100%}
.back{
  display:inline-block;font-size:11px;letter-spacing:.2em;color:#6f6f6f;
  text-transform:uppercase;padding:8px 0 26px;
}
.back:hover{color:#000}
.pdp-grid{display:grid;grid-template-columns:1fr;gap:32px}
.pdp-main{
  position:relative;aspect-ratio:3/4;background:#fff;border:1px solid var(--rule);overflow:hidden;
}
.pdp-main img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;opacity:0;transition:opacity .35s}
.pdp-main img.on{opacity:1}
.thumbs{display:flex;gap:10px;padding-top:14px}
.thumb{
  width:74px;aspect-ratio:3/4;border:1px solid var(--rule);background:#fff;
  padding:0;overflow:hidden;flex:none;
}
.thumb img{width:100%;height:100%;object-fit:contain}
.thumb.on{border-color:#000}
.pdp-info h2{font-size:24px;letter-spacing:.22em;font-weight:400;padding-bottom:10px}
.pdp-price{font-size:17px;letter-spacing:.02em}
.stock{
  display:flex;align-items:center;gap:8px;font-size:10.5px;letter-spacing:.18em;
  color:#6f6f6f;text-transform:uppercase;padding-top:14px;
}
.stock i{width:6px;height:6px;border-radius:50%;background:#2e8b57;display:block}
.stock.out i{background:#b9b9b9}
.ships{font-size:10.5px;letter-spacing:.16em;color:#a0a0a0;text-transform:uppercase;padding-top:8px}
.pdp-desc{
  font-size:12px;letter-spacing:.055em;line-height:1.95;color:#4a4a4a;
  text-transform:uppercase;padding:30px 0 0;border-top:1px solid var(--rule);margin-top:26px;
}
.pdp-sizes{padding-top:38px}
.pdp-sizes .label{font-size:10.5px;letter-spacing:.2em;color:#6f6f6f;text-transform:uppercase}
.pdp-sizes .row{display:flex;gap:8px;padding-top:14px;flex-wrap:wrap}
.pdp-sizes button{
  min-width:56px;padding:14px 8px;border:1px solid var(--rule);background:#fff;
  font-size:12px;letter-spacing:.12em;color:#4a4a4a;
}
.pdp-sizes button:hover{border-color:#9b9b9b}
.pdp-sizes button.on{background:#000;border-color:#000;color:#fff}
.buy{
  display:block;width:100%;margin-top:30px;background:transparent;color:#000;border:1px solid #000;
  padding:13px 20px;text-align:center;font-size:11px;letter-spacing:.2em;text-transform:uppercase;transition:background .2s,color .2s;
}
.buy:hover{background:#000;color:#fff}
.bagbtn{
  display:block;width:100%;margin-top:12px;border:1px solid var(--rule);background:#fff;
  padding:16px 20px;font-size:11px;letter-spacing:.2em;color:#4a4a4a;text-transform:uppercase;
}
.bagbtn:hover{border-color:#000;color:#000}
@media (min-width:900px){
  .pdp{padding:24px 32px 90px}
  .pdp-grid{grid-template-columns:1.15fr .85fr;gap:56px}
  .pdp-info{padding-top:8px}
}

/* ---------- gallery ---------- */
.gal-wrap{max-width:1180px;margin:0 auto;padding:38px 16px 80px;width:100%}
.gal{
  display:grid;grid-template-columns:1fr;gap:12px;padding-top:26px;
}
.gal figure{margin:0;cursor:zoom-in;background:#fff;border:1px solid var(--rule);overflow:hidden}
.gal img{display:block;width:100%;height:100%;object-fit:cover;aspect-ratio:4/5;transition:opacity .3s}
.gal figure:hover img{opacity:.85}
.gal figcaption{
  font-size:10px;letter-spacing:.16em;color:#9a9a9a;text-transform:uppercase;
  padding:10px 12px 12px;
}
.gal-empty{
  font-size:11px;letter-spacing:.18em;color:#b0b0b0;text-transform:uppercase;
  padding-top:40px;text-align:center;
}
.gal-empty.hide{display:none}
.lightbox{
  position:fixed;inset:0;z-index:90;background:rgba(255,255,255,.97);
  display:none;align-items:center;justify-content:center;padding:56px 16px 70px;
}
.lightbox.show{display:flex}
.lightbox img{max-width:100%;max-height:100%;object-fit:contain}
.lb-close{position:absolute;top:18px;right:20px;font-size:24px;line-height:1;color:#4a4a4a}
.lb-nav{
  position:absolute;top:50%;transform:translateY(-50%);
  font-size:40px;line-height:1;color:#9a9a9a;padding:16px;
}
.lb-nav:hover{color:#000}
.lb-nav.prev{left:4px}
.lb-nav.next{right:4px}
.lb-cap{
  position:absolute;bottom:24px;left:0;right:0;text-align:center;
  font-size:10px;letter-spacing:.18em;color:#9a9a9a;text-transform:uppercase;
}
@media (min-width:640px){ .gal{grid-template-columns:repeat(2,1fr);gap:16px} }
@media (min-width:1000px){
  .gal{grid-template-columns:repeat(3,1fr);gap:20px}
  .gal-wrap{padding:52px 32px 90px}
}

/* ---------- routed pages ---------- */
.page{display:none}
.page.on{display:block}
.wrap{max-width:1180px;margin:0 auto;padding:38px 16px 70px;width:100%}
.sec-head{
  display:flex;justify-content:space-between;align-items:baseline;gap:16px;
  font-size:11px;letter-spacing:.18em;color:#6f6f6f;text-transform:uppercase;
  border-bottom:1px solid var(--rule);padding-bottom:14px;margin-bottom:0;
}
.sec-head .r{color:#b0b0b0;text-align:right}
.cards{
  display:grid;grid-template-columns:1fr;
  border-left:1px solid var(--rule);border-top:1px solid var(--rule);
  margin-bottom:44px;
}
.cards.two{grid-template-columns:1fr}
.cardx{
  background:#fff;padding:26px 22px 24px;position:relative;
  border-right:1px solid var(--rule);border-bottom:1px solid var(--rule);
  display:flex;flex-direction:column;
}
.cardx .num{position:absolute;top:22px;right:22px;font-size:10px;letter-spacing:.14em;color:#c2c2c2}
.cardx h3{font-size:18px;font-weight:700;letter-spacing:.02em;text-transform:uppercase;padding-top:4px}
.cardx .kicker{font-size:10px;letter-spacing:.14em;color:#b0b0b0;text-transform:uppercase}
.cardx p{
  font-size:12.5px;letter-spacing:.055em;line-height:1.85;color:#4a4a4a;
  text-transform:uppercase;padding-top:14px;
}
.cardx .foot{
  display:flex;justify-content:space-between;gap:12px;margin-top:auto;padding-top:30px;
  font-size:10px;letter-spacing:.14em;color:#b0b0b0;text-transform:uppercase;
}
.tag{
  display:inline-block;border:1px solid var(--rule);border-radius:999px;
  padding:5px 12px;font-size:9.5px;letter-spacing:.16em;color:#6f6f6f;
  text-transform:uppercase;margin-bottom:14px;
}
.pill-row{display:flex;flex-direction:column;gap:12px;padding-top:16px}
.pill-row div{
  display:flex;justify-content:space-between;gap:16px;align-items:baseline;
  font-size:11px;letter-spacing:.12em;text-transform:uppercase;
}
.pill-row .k{color:#6f6f6f;display:flex;gap:8px;align-items:center}
.pill-row .v{font-weight:700;color:#1a1a1a;text-align:right}
.tick{width:12px;height:12px;stroke:#9b9b9b;fill:none;stroke-width:1.6;flex:none}

/* material feature card */
.material{position:relative;background:#fff;border:1px solid var(--rule);padding:32px 24px;margin-bottom:46px}
.material .badge{
  position:absolute;top:24px;right:24px;display:flex;align-items:center;gap:7px;
  font-size:10px;letter-spacing:.14em;color:#6f6f6f;text-transform:uppercase;
}
.material h3{font-size:clamp(20px,4.6vw,30px);font-weight:700;letter-spacing:-.005em;padding-top:6px;text-transform:uppercase}
.material p{font-size:12px;letter-spacing:.07em;color:#5a5a5a;padding-top:14px;text-transform:uppercase;line-height:1.8}

/* contact page */
.contact{max-width:640px;margin:0 auto;text-align:center;padding:34px 16px 80px}
.contact h2{font-size:26px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
.contact .mail{display:inline-block;margin-top:14px;font-size:14px;border-bottom:1px solid #b6b6b6;padding-bottom:2px}
.contact .blurb{font-size:13.5px;color:#4a4a4a;padding-top:22px;line-height:1.7}
.cform{display:flex;flex-direction:column;gap:34px;padding-top:52px;text-align:left}
.field label{display:block;font-size:13px;color:#8a8a8a;padding-bottom:8px}
.field input,.field textarea{
  width:100%;border:0;border-bottom:1px solid var(--rule);background:none;
  padding:6px 0 10px;font-size:15px;outline:none;resize:none;
}
.field input:focus,.field textarea:focus{border-bottom-color:#000}
.legal-note{font-size:10px;letter-spacing:.1em;color:#a8a8a8;text-transform:uppercase;line-height:1.9;padding-top:44px}
.submit{
  margin:26px auto 0;display:block;font-size:13px;letter-spacing:.3em;
  border-bottom:1px solid #000;padding:0 10px 10px;text-transform:uppercase;
}
.form-note{font-size:11px;letter-spacing:.14em;color:#6f6f6f;padding-top:18px;text-transform:uppercase;min-height:14px}

/* simple text page */
.textpage{max-width:760px;margin:0 auto;padding:40px 16px 90px}
.textpage h2{font-size:22px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding-bottom:20px}
.textpage p{font-size:14px;line-height:1.9;color:#4a4a4a;padding-bottom:16px}
.textpage h3{
  font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:#1a1a1a;
  padding:26px 0 10px;border-top:1px solid var(--rule);margin-top:14px;
}
.textpage h3:first-of-type{margin-top:6px}
.textpage a{border-bottom:1px solid #c9c9c9}
.textpage a:hover{border-bottom-color:#000}
.textpage strong{color:#1a1a1a;font-weight:600}
.textpage.centered h2{text-align:center;letter-spacing:.16em}
.textpage.centered .stamp{text-align:center}
.policy-plain p{
  text-transform:uppercase;font-size:12px;letter-spacing:.055em;line-height:1.95;
  color:#4a4a4a;padding-bottom:22px;
}
.policy-plain strong{text-transform:none}
.policy-box{
  border:1px solid var(--rule);padding:30px 26px;text-align:center;margin-top:10px;
}
.policy-box p{padding-bottom:0;text-transform:none;font-size:14px;letter-spacing:.01em;line-height:1.8}
.stamp{
  font-size:10px;letter-spacing:.18em;color:#b0b0b0;text-transform:uppercase;
  padding-bottom:26px!important;
}

@media (min-width:820px){
  .cards.two{grid-template-columns:1fr 1fr}
  .wrap{padding:52px 32px 80px}
  .material{padding:44px 40px}
  .cardx{padding:32px 28px 28px}
}

/* ---------- announcement ---------- */
.announce{
  position:relative;background:#000;color:#fff;
  display:flex;align-items:center;justify-content:center;
  height:36px;padding:0 44px;font-size:11px;letter-spacing:3px;text-transform:uppercase;text-align:center;
}
.announce.hidden{display:none}
.announce p{margin:0;transition:opacity .5s ease}
.announce p.fade{opacity:0}
.announce button{position:absolute;right:14px;top:50%;transform:translateY(-50%);color:#fff;opacity:.7;font-size:13px;line-height:1;padding:2px 4px}
.announce button:hover{opacity:1}

/* ---------- header ---------- */
.header{
  position:sticky;top:0;z-index:40;
  background:var(--white);
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 20px;
  border-bottom:1px solid transparent;
}
.header.scrolled{border-bottom-color:var(--rule)}
.wordmark{
  font-family:var(--display);
  font-size:27px;letter-spacing:-.01em;line-height:1;
  text-transform:uppercase;transform:scaleX(.94);transform-origin:left center;
}
.header{position:sticky}
.nav-actions{position:absolute;top:8px;right:14px;display:flex;align-items:center;gap:14px;font-family:var(--sans);font-size:10px;letter-spacing:.18em;text-transform:uppercase;line-height:1}
.nav-actions button{display:flex;align-items:center;gap:5px;font:inherit;letter-spacing:inherit;text-transform:inherit;padding:4px 0}
.nav-actions .icon{width:11px;height:11px}
@media (max-width:699px){.header{padding-top:32px}}
.icon{width:17px;height:17px;stroke:currentColor;fill:none;stroke-width:1.6}
.cart-count{font-variant-numeric:tabular-nums}

/* ---------- product grid ---------- */
.grid{
  display:grid;grid-template-columns:1fr;
  gap:52px 12px;
  padding:24px 12px 60px;
  max-width:1180px;margin:0 auto;width:100%;
}
.grid:has(.card:only-child){max-width:520px}
.card{text-align:center}
.frame{
  background:var(--tile);
  padding:14px;
  position:relative;
}
.shot{
  position:relative;
  aspect-ratio:3/4;
  background:#ffffff;
  border:1px solid #e6e5e1;
  overflow:hidden;
  cursor:pointer;
}
.shot img{
  position:absolute;inset:0;width:100%;height:100%;
  object-fit:contain;opacity:0;transition:opacity .4s ease;
}
.shot img.on{opacity:1}
.dot{cursor:pointer}
.sizes{display:flex;justify-content:center;gap:5px;padding-top:16px;flex-wrap:wrap}
.size{
  min-width:34px;padding:7px 3px;font-size:11px;letter-spacing:.12em;
  border:1px solid var(--rule);color:#6f6f6f;background:#fff;
}
.size:hover{border-color:#9b9b9b}
.size.on{border-color:#000;color:#000;background:#000;color:#fff}
.dots{position:absolute;left:0;right:0;bottom:12px;display:flex;justify-content:center;gap:9px;z-index:2}
.dot{width:9px;height:9px;border-radius:50%;background:#c9c8c4}
.dot.on{background:#000}
.meta{padding-top:18px;font-size:19px;letter-spacing:.22em}
.price{padding-top:8px;font-size:17px;letter-spacing:.02em;color:#1a1a1a}
.soldout{font-size:12px;letter-spacing:.18em;color:var(--gray-light);padding-top:6px}
.add{
  margin-top:14px;font-size:11px;letter-spacing:.2em;
  border-bottom:1px solid #000;padding-bottom:2px;
}
.add[disabled]{border-color:var(--rule);color:var(--gray-light);cursor:default}
.add{display:inline-block}
.buynow{
  display:block;width:100%;max-width:200px;margin:14px auto 0;
  background:transparent;color:#000;border:1px solid #000;padding:10px 16px;text-align:center;
  font-size:10px;letter-spacing:.2em;transition:background .2s,color .2s;
}
.buynow:hover{background:#000;color:#fff}
.r-secure{
  text-align:center;font-size:11px;letter-spacing:.16em;color:#9a9a9a;padding-top:12px;
}
a.r-cta{text-decoration:none}

/* ---------- footer ---------- */
.footer{background:var(--white);border-top:1px solid var(--rule);padding:48px 20px 24px;color:#111}
.ft-h{display:block;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#8a8a8a;margin-bottom:14px}
.ft-top{display:grid;gap:40px}
.ft-mark{font-family:var(--display);font-size:30px;letter-spacing:.01em;line-height:1}
.ft-tag{margin-top:10px;max-width:34ch;font-size:14px;color:var(--gray);line-height:1.5}
.ft-small{font-size:13px;color:var(--gray);margin:-6px 0 12px}
.news{margin-top:28px;max-width:420px}
.news form{display:flex;align-items:stretch;border:1px solid #111}
.news input{flex:1;min-width:0;border:0;background:none;font-size:15px;padding:12px 14px;outline:none}
.news input::placeholder{color:var(--gray-light)}
.news form:focus-within{outline:2px solid #000;outline-offset:2px}
.ft-join{padding:0 20px;background:#111;color:#fff;font-size:12px;letter-spacing:.16em;text-transform:uppercase}
.ft-join:hover{background:#333}
.news-note{margin-top:10px;font-size:12px;letter-spacing:.08em;color:var(--gray);min-height:16px}
.ft-cols{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 20px}
.ft-col a{display:block;width:fit-content;font-size:14px;padding:5px 0;color:#111;border-bottom:1px solid transparent}
.ft-col a:hover{border-bottom-color:#111}
.ft-prefs{margin-top:44px;padding-top:24px;border-top:1px solid var(--rule);display:grid;gap:18px}
.ft-pref .ft-h{margin-bottom:8px}
.ft-pref .switch-row{justify-content:flex-start;gap:6px 16px;font-size:13px;letter-spacing:.04em}
.opt{padding:1px 0;border-bottom:1px solid transparent;color:#6f6f6f}
.opt.on{border-bottom-color:#000;color:#000;font-weight:500}
.opt:not(.on):hover{color:#000;border-bottom-color:#cfcfcf}
.switch-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:6px 12px}
.ft-base{margin-top:32px;padding-top:18px;border-top:1px solid var(--rule);display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 20px;font-size:12px;letter-spacing:.06em;color:var(--gray)}
.sep{color:var(--gray-light);font-size:13px}
.pipe{color:#c9c9c9}
.label{color:var(--gray-light);letter-spacing:.06em}
.muted{color:var(--gray-light)}
@media (min-width:700px){
  .footer{padding:64px 32px 28px}
  .ft-cols{grid-template-columns:repeat(4,minmax(0,1fr))}
  .ft-prefs{grid-template-columns:auto auto auto;justify-content:start;column-gap:56px}
}
@media (min-width:1080px){
  .ft-top{grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:64px}
}

.totop{
  position:fixed;right:16px;bottom:22px;z-index:30;
  width:54px;height:54px;border-radius:50%;
  background:#fff;border:1px solid var(--rule);
  display:grid;place-items:center;
  box-shadow:0 2px 10px rgba(0,0,0,.06);
  opacity:0;pointer-events:none;transition:opacity .25s;
}
.totop.show{opacity:1;pointer-events:auto}

/* ---------- overlays ---------- */
.scrim{
  position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.28);
  opacity:0;pointer-events:none;transition:opacity .28s;
}
.scrim.show{opacity:1;pointer-events:auto}

.menu{
  position:fixed;top:0;bottom:0;left:0;z-index:60;width:min(360px,88vw);background:var(--white);
  display:flex;flex-direction:column;font-family:var(--sans);color:#111;
  padding:18px 24px 22px;overflow-y:auto;box-shadow:0 0 40px rgba(0,0,0,.12);
  transform:translateX(-102%);transition:transform .34s cubic-bezier(.4,0,.2,1);
}
.menu.show{transform:translateX(0)}
.mn-head{display:flex;align-items:center;justify-content:space-between;padding-bottom:18px;border-bottom:1px solid var(--rule)}
.mn-head .wordmark{font-size:24px}
.mn-main{display:flex;flex-direction:column;padding:10px 0 14px;border-bottom:1px solid var(--rule)}
.mn-main a{display:flex;justify-content:space-between;align-items:baseline;padding:12px 0;font-size:17px;letter-spacing:.14em;text-transform:uppercase}
.mn-main a span{border-bottom:1px solid transparent;padding-bottom:1px}
.mn-main a:hover span,.mn-main a.is-active span{border-bottom-color:#111}
