<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>D3COMPOSURE</title>
<meta name="description" content="D3COMPOSURE — clothing that functions as structured thought. Made to order in Portugal.">
<meta property="og:title" content="D3COMPOSURE">
<meta property="og:description" content="Clothing that functions as structured thought. Made to order in Portugal.">
<meta property="og:type" content="website">
<meta name="theme-color" content="#ffffff">
