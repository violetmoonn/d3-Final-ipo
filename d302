/* ---------- receipt ---------- */
function stamp(){
  const d = new Date();
  const p = n => String(n).padStart(2,"0");
  document.getElementById("rStamp").textContent =
    `DATE: ${p(d.getMonth()+1)}/${p(d.getDate())}/${d.getFullYear()}  •  TIME: ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
}
const TRANS = 700000 + Math.floor(Math.random()*99999);
document.getElementById("rTrans").textContent = `TRANS #${TRANS} // TERM-01`;

function drawBarcode(){
  const bar = document.getElementById("barcode");
  bar.innerHTML = "";
  let seed = TRANS;
  for(let i=0;i<52;i++){
    seed = (seed*1103515245 + 12345) % 2147483648;
    const w = 1 + (seed >> 16) % 4;
    const b = document.createElement("i");
    b.style.width = w+"px";
    b.style.opacity = (seed>>8)%5 === 0 ? ".15" : "1";
    bar.appendChild(b);
  }
}

function renderCart(){
  stamp();
  const body = document.getElementById("rBody");
  const items = [...cart.entries()];
  if(!items.length){
    body.innerHTML = `
      <p class="r-empty">YOUR CART IS EMPTY</p>
      <p class="r-empty-sub">NO ITEMS SCANNED TO THIS RECEIPT</p>
      <button class="r-cta" data-close>EXPLORE COLLECTION <span>→</span></button>
      <div style="height:22px"></div>`;
    document.getElementById("barnum").textContent = "*D3-0-0*";
    return;
  }
  let sub = 0, units = 0;
  const rows = items.map(([key,q]) => {
    const [id,size] = key.split("|");
    const p = PRODUCTS.find(x=>x.id===id);
    sub += p.usd*q; units += q;
    return `<div class="r-item">
      <span>${p.id}<br><span class="qty">${p.note} // SIZE ${size} // QTY ${q}</span></span>
      <span class="amt">${money(p.usd*q)}</span>
      <span class="row2">
        <button data-dec="${key}">− REMOVE ONE</button>
        <button data-del="${key}">VOID LINE</button>
      </span>
    </div>`;
  }).join("");
  body.innerHTML = `
    <div class="r-items">${rows}</div>
    <div class="tear"></div>
    <div class="r-totals">
      <div><span>SUBTOTAL (${units} ITEM${units>1?"S":""})</span><span>${money(sub)}</span></div>
      <div class="note"><span>SHIPPING &amp; TAX</span><span>CALCULATED AT CHECKOUT</span></div>
      <div class="grand"><span>TOTAL DUE</span><span>${money(sub)}</span></div>
    </div>
    <p class="r-ship">MADE TO ORDER IN PORTUGAL // SHIPS IN APPROX. 2 WEEKS</p>
    <div style="height:20px"></div>
    <a class="r-cta" id="checkoutBtn" href="${checkoutURL()}">CHECKOUT <span>→</span></a>
    <p class="r-secure">SECURE CHECKOUT VIA STRIPE</p>
    <div style="height:22px"></div>`;
  document.getElementById("barnum").textContent = `*D3-${units}-${Math.round(sub)}*`;
}

document.getElementById("rBody").addEventListener("click", e => {
  const dec = e.target.closest("[data-dec]"), del = e.target.closest("[data-del]");
  if(dec){
    const id = dec.dataset.dec, q = cart.get(id)-1;
    q > 0 ? cart.set(id,q) : cart.delete(id);
  } else if(del){
    cart.delete(del.dataset.del);
  } else return;
  renderCart(); updateCount();
});

