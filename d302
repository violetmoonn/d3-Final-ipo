const scrim = document.getElementById("scrim");
const panels = {menu:document.getElementById("menu"), search:document.getElementById("search"), cart:document.getElementById("cart")};
function open(name){
  closeAll();
  panels[name].classList.add("show");
  scrim.classList.add("show");
  document.body.classList.add("locked");
  if(name==="cart"){ renderCart(); drawBarcode(); }
  if(name==="search") setTimeout(()=>document.getElementById("searchInput").focus(),260);
}
function closeAll(){
  Object.values(panels).forEach(p => p.classList.remove("show"));
  scrim.classList.remove("show");
  document.body.classList.remove("locked");
}
