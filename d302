    <div class="pdp-grid">
      <div>
        <div class="pdp-main" id="pdpMain">
          ${p.imgs.map((im,n)=>`<img src="${im.src}" alt="${im.alt}" class="${n?'':'on'}">`).join("")}
        </div>
        <div class="thumbs" id="pdpThumbs">
          ${p.imgs.map((im,n)=>`<button class="thumb${n?'':' on'}"><img src="${im.src}" alt=""></button>`).join("")}
        </div>
      </div>
      <div class="pdp-info">
        <h2>${p.id}</h2>
        <p class="pdp-price">${money(p.usd)}</p>
        <p class="stock${p.stock?'':' out'}"><i></i>${p.stock?"Available — made to order":"Sold out"}</p>
        ${p.stock?`<p class="ships">Ships in approx. 2 weeks from Portugal</p>`:``}
        <p class="pdp-desc">${p.desc||""}</p>
        ${p.stock ? `
        <div class="pdp-sizes" id="pdpSizes">
          <span class="label">Select size</span>
          <div class="row">${p.sizes.map(sz=>`<button class="${sz==="L"?"on":""}">${sz}</button>`).join("")}</div>
        </div>
        <a class="buy" id="pdpBuy" href="${STRIPE_LINK}">Buy</a>
        <button class="bagbtn" id="pdpBag">+ Add to shopping bag</button>` : ``}
      </div>
    </div>`;

  const main = body.querySelector("#pdpMain");
  if(!main) return;
  const figs = main.querySelectorAll("img");
  const thumbs = body.querySelectorAll(".thumb");
  thumbs.forEach((t,n) => t.addEventListener("click", () => {
    figs.forEach((f,m)=>f.classList.toggle("on", m===n));
    thumbs.forEach((x,m)=>x.classList.toggle("on", m===n));
  }));

  const sizes = body.querySelector("#pdpSizes");
  const chosen = () => body.querySelector(".pdp-sizes button.on")?.textContent || "OS";
  if(sizes) sizes.addEventListener("click", e => {
    const b = e.target.closest("button");
    if(!b) return;
    sizes.querySelectorAll("button").forEach(x => x.classList.toggle("on", x===b));
  });

  const buy = body.querySelector("#pdpBuy");
  if(buy) buy.addEventListener("click", () => {
    const u = new URL(STRIPE_LINK);
    u.searchParams.set("client_reference_id", p.id.replace(/\s/g,"") + "-" + chosen() + "x1");
    buy.href = u.toString();
  });

  const bag = body.querySelector("#pdpBag");
  if(bag) bag.addEventListener("click", () => {
    const key = p.id + "|" + chosen();
    cart.set(key, (cart.get(key)||0)+1);
    bag.textContent = "Added to bag";
    setTimeout(()=>bag.textContent = "+ Add to shopping bag", 1000);
    renderCart(); updateCount();
  });
}

function route(){
  let hash = (location.hash || "#shop").slice(1).toLowerCase();
  let target = "shop";

  const prod = hash.startsWith("product/")
    ? PRODUCTS.find(p => slug(p.id) === hash.split("/")[1]) : null;

  if(prod){
    target = "product";
    renderPDP(prod);
  } else if(PAGES.includes(hash)){
    target = hash;
  } else if(LEGAL[hash]){
    target = "legal";
    document.getElementById("legalTitle").textContent = LEGAL[hash].title;
    const L = LEGAL[hash];
    const bodyEl = document.getElementById("legalBody");
    bodyEl.innerHTML = L.boxed ? `<div class="policy-box">${L.body}</div>` : L.body;
    bodyEl.className = L.plain ? "policy-plain" : "";
    document.querySelector("#page-legal .textpage").classList.toggle("centered", !!L.plain);
    document.getElementById("legalStamp").textContent = "Last updated " + POLICY_UPDATED;
  }

  document.querySelectorAll(".page").forEach(p =>
    p.classList.toggle("on", p.id === "page-" + target));
  lbHide();
  closeAll();
  document.querySelectorAll("[data-drop]").forEach(d => d.classList.remove("open"));
  window.scrollTo(0,0);
}
addEventListener("hashchange", route);
route();

/* contact form */
document.getElementById("contactForm").addEventListener("submit", e => {
  e.preventDefault();
  const f = e.target;
  const subject = encodeURIComponent("Inquiry from " + f.querySelector("#cName").value);
  const body = encodeURIComponent(
    f.querySelector("#cMsg").value + "\n\n— " +
    f.querySelector("#cName").value + " (" + f.querySelector("#cMail").value + ")");
  document.getElementById("contactNote").textContent = "Opening your mail app…";
  location.href = `mailto:inquire@d3composure.com?subject=${subject}&body=${body}`;
});


/* ---------- entry gate ---------- */
const gate = document.getElementById("gate");
document.body.classList.add("gated");
function enter(){
  if(gate.classList.contains("gone")) return;
  gate.classList.add("gone");
  document.body.classList.remove("gated");
  setTimeout(() => gate.remove(), 700);
}
gate.addEventListener("click", enter);
gate.addEventListener("keydown", e => { if(e.key==="Enter"||e.key===" ") { e.preventDefault(); enter(); } });
</script>
