/* lightbox */
const lb = document.getElementById("lightbox");
const lbImg = document.getElementById("lbImg");
const lbCap = document.getElementById("lbCap");
let lbIndex = 0;

function lbShow(i){
  if(!GALLERY.length) return;
  lbIndex = (i + GALLERY.length) % GALLERY.length;
  const g = GALLERY[lbIndex];
  lbImg.src = g.src;
  lbImg.alt = g.caption || "";
  lbCap.textContent = g.caption || "";
  lb.classList.add("show");
  document.body.classList.add("locked");
}
function lbHide(){
  lb.classList.remove("show");
  document.body.classList.remove("locked");
}
document.getElementById("gal").addEventListener("click", e => {
  const fig = e.target.closest("[data-lb]");
  if(fig) lbShow(+fig.dataset.lb);
});
document.getElementById("lbPrev").onclick = e => { e.stopPropagation(); lbShow(lbIndex-1); };
document.getElementById("lbNext").onclick = e => { e.stopPropagation(); lbShow(lbIndex+1); };
lb.addEventListener("click", e => { if(e.target === lb || e.target.closest("[data-lb-close]")) lbHide(); });
document.addEventListener("keydown", e => {
  if(!lb.classList.contains("show")) return;
  if(e.key === "Escape") lbHide();
  if(e.key === "ArrowLeft") lbShow(lbIndex-1);
  if(e.key === "ArrowRight") lbShow(lbIndex+1);
});

