(function(){
  const menu = document.getElementById("menu");
  menu.querySelectorAll("[data-group]").forEach(g => {
    const t = g.querySelector(".mn-toggle");
    t.addEventListener("click", () => { const o = !g.classList.contains("open"); g.classList.toggle("open", o); t.setAttribute("aria-expanded", o); });
  });
  const mark = () => {
    const h = (location.hash || "#shop").slice(1).toLowerCase().split("/")[0];
    menu.querySelectorAll("[data-route]").forEach(a => {
      const on = a.dataset.route === h;
      a.classList.toggle("is-active", on);
      const g = on && a.closest("[data-group]");
      if(g){ g.classList.add("open"); g.querySelector(".mn-toggle").setAttribute("aria-expanded","true"); }
    });
  };
  addEventListener("hashchange", mark); mark();
  // Bag row mirrors the header count and opens the bag
  const src = document.getElementById("cartCount"), dst = document.getElementById("mnBagCount");
  const sync = () => { dst.textContent = src.textContent.replace(/[()]/g,"").trim(); };
  new MutationObserver(sync).observe(src, {childList:true, characterData:true, subtree:true}); sync();
  document.getElementById("mnBag").addEventListener("click", e => { e.preventDefault(); closeAll(); open("cart"); });
  document.getElementById("dirNews").addEventListener("click", e => {
    e.preventDefault(); closeAll();
