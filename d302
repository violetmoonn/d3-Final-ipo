/* [STRIPE] */ const STRIPE_LINK = "https://buy.stripe.com/00w4gB4II5Av2qQgsmfjG0a";

// Builds the checkout URL. client_reference_id carries the bag contents
// through to the Stripe dashboard so you can see size + qty on the order.
function checkoutURL(){
  const ref = [...cart.entries()]
    .map(([key,q]) => key.replace(/[^A-Za-z0-9|]/g,"").replace("|","-") + "x" + q)
    .join("_")
    .slice(0,180);
  const u = new URL(STRIPE_LINK);
  if(ref) u.searchParams.set("client_reference_id", ref);
  return u.toString();
}

const RATES = {USD:[1,"$","USD"],EUR:[.92,"€","EUR"],GBP:[.79,"£","GBP"],JPY:[147,"¥","JPY"],KRW:[1330,"₩","KRW"]};
let CUR = "USD";
const cart = new Map();

const money = usd => {
  const [rate,sym,code] = RATES[CUR];
  const v = usd*rate;
  const n = (code==="JPY"||code==="KRW") ? Math.round(v).toLocaleString("en-US")
                                         : v.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g,",");
  return sym+n+" "+code;
};

